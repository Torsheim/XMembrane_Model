    "note": "This analysis registers evidence and decision boundaries. It does not promote conditional model results to demonstrated system savings."
  },
  "ordinal_categories": {
    "decision_impact_high_to_low": [
      {
        "id": "I_SIGN_OR_GO_NO_GO_CAN_CHANGE",
        "definition": "Existing registered calculations cross zero, switch pass/fail, or contain a quantified omitted load large enough to consume the current margin."
      },
      {
        "id": "II_CURRENT_EVIDENCE_GATE_BLOCKED",
        "definition": "All current registered evidence fails a named physical or diagnostic gate, so the present candidate set cannot be promoted without resolving that gate. This does not mean a current-density acceptance limit."
      },
      {
        "id": "III_MATERIAL_REALITY_UNVALIDATED",
        "definition": "The inverse-design coordinates are not yet constrained to a simultaneously measured, correlated material vector, so positive coordinate combinations cannot be treated as a purchasable material population."
      },
      {
        "id": "IV_DESIGN_SPACE_COVERAGE_INCOMPLETE",
        "definition": "Numerical failures or right-censored rows leave a material part of the sampled design space unresolved; those rows are neither demonstrated passes nor physical no-go results."
      },
      {
        "id": "V_FULL_SYSTEM_CLAIM_BLOCKED",
        "definition": "The subsystem is not evaluated or validated and therefore blocks a full-system claim, but no current evidence quantifies a sign reversal by itself."
      },
      {
        "id": "VI_DECISION_COMMUNICATION_OR_QUALIFICATION",
        "definition": "The item governs correct interpretation, product qualification, or annual durability after the immediate physical and energy gates survive."
      }
    ],
    "closure_effort_low_to_high": [
      {
        "id": "I_EXISTING_DATA_REPLAY",
        "definition": "Can be resolved from existing registered data or a bounded solver replay without new hardware measurements."
      },
      {
        "id": "II_BENCH_OR_SITE_MEASUREMENT_PLUS_REPLAY",
        "definition": "Needs a bounded coupon, side-stream, calorimetric, electrical, or site measurement followed by a registered model replay."
      },
      {
        "id": "III_MODULE_HARDWARE_PROGRAM",
        "definition": "Needs module-scale channels, headers, manifolds, electrodes, or packaging hardware before the model can be closed."
      },
      {
        "id": "IV_LIFETIME_AND_MANUFACTURING_PROGRAM",
        "definition": "Needs cyclic ageing, production variation, or end-of-life evidence across a sustained test programme."
      }
    ]
  },
